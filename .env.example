OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- OTEL — point at local Grafana LGTM stack (started via `make otel-up`) ---
# Host ports remapped because 4317/4318 are already taken by other local infra.
# Leave blank / unset to disable OTEL export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4328
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Traces and metrics work through the SDK's telemetry pipeline (Agent.instrument_all).
# Logs OTLP export is disabled — BambooHR's otel_instrumentation_python doesn't support
# it, and enabling standard OTLP-logs export produces 404s against LGTM's default paths.
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=otlp
OTEL_INSTRUMENTATION_GENAI_EMIT_EVENT=true
